    "sources": {
      "example.test.ts": "import { describe, expect, it } from 'vitest'\n\ndescribe('normal patterns', async () => {\n  it.each([[1], [2]])('table row %i', (value) => {\n    expect(value).toBeGreaterThan(0)\n  })\n  it.skipIf(process.platform === 'win32')('platform condition', () => {\n    expect(process.platform).not.toBe('win32')\n  })\n  it('poll', async () => {\n    await expect.poll(() => 1).toBe(1)\n  })\n})\n",
      "focused.test.ts": "import { expect, it } from 'vitest'\nit.only('focused', () => expect(1).toBe(1))\nit('other', () => expect(1).toBe(1))\n",
      "src.ts": "const item = { only: () => 1 }\nitem.only()\n"
    }
  },
