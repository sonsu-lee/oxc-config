{
  "toolVersions": {
    "node": "24.18.1",
    "oxlint": "1.85.0",
    "oxfmt": "0.70.0",
    "vitest": "5.0.2",
    "typescript": "7.0.2",
    "oxlint-tsgolint": "7.0.2003"
  },
  "commands": {
    "isolatedRule": "oxlint -c <case>/.oxlintrc.json -f json <case>/{invalid,valid}.test.ts",
    "fix": "oxlint -c <case>/.oxlintrc.json --fix|--fix-suggestions <case>/<copy>.test.ts",
    "scoped": "oxlint -c oxlint-scoped.json --deny-warnings -f json example.test.ts src.ts | focused.test.ts src.ts",
    "runner": "vitest run example.test.ts --reporter=dot | vitest run focused.test.ts --reporter=dot"
  },
  "isolatedRules": [
    {
      "rule": "vitest/no-focused-tests",
      "options": null,
      "invalidSource": "import {it,expect} from 'vitest'; it.only('works',()=>expect(1).toBe(1));",
      "validSource": "import {it,expect} from 'vitest'; it('works',()=>expect(1).toBe(1));",
      "invalid": {
        "exit": 1,
        "diagnostics": [
          {
            "code": "vitest(no-focused-tests)",
            "severity": "error",
            "message": "Unexpected focused test."
          }
        ]
      },
      "valid": {
        "exit": 0,
        "diagnostics": []
      },
      "--fix": {
        "exit": 1,
        "changed": false,
        "after": null
      },
      "--fix-suggestions": {
        "exit": 0,
        "changed": true,
        "after": "import {it,expect} from 'vitest'; it('works',()=>expect(1).toBe(1));"
      }
    },
    {
      "rule": "vitest/no-disabled-tests",
      "options": null,
      "invalidSource": "import {it,expect} from 'vitest'; it.skip('works',()=>expect(1).toBe(1));",
      "validSource": "import {it,expect} from 'vitest'; it('works',()=>expect(1).toBe(1));",
      "invalid": {
        "exit": 1,
        "diagnostics": [
          {
            "code": "vitest(no-disabled-tests)",
            "severity": "error",
            "message": "Disabled test"
          }
        ]
      },
      "valid": {
        "exit": 0,
        "diagnostics": []
      },
      "--fix": {
        "exit": 1,
        "changed": false,
        "after": null
      },
      "--fix-suggestions": {
        "exit": 1,
        "changed": false,
        "after": null
      }
    },
    {
      "rule": "vitest/consistent-test-it",
      "options": {
        "fn": "it",
        "withinDescribe": "it"
      },
      "invalidSource": "import {test,expect} from 'vitest'; test('works',()=>expect(1).toBe(1));",
      "validSource": "import {it,expect} from 'vitest'; it('works',()=>expect(1).toBe(1));",
      "invalid": {
        "exit": 1,
        "diagnostics": [
          {
            "code": "vitest(consistent-test-it)",
            "severity": "error",
            "message": "Enforce `test` and `it` usage conventions"
          }
        ]
      },
      "valid": {
        "exit": 0,
        "diagnostics": []
      },
      "--fix": {
        "exit": 0,
        "changed": true,
        "after": "import {test,expect} from 'vitest'; it('works',()=>expect(1).toBe(1));"
      },
      "--fix-suggestions": {
        "exit": 1,
        "changed": false,
        "after": null
      }
    },
    {
      "rule": "vitest/no-identical-title",
      "options": null,
      "invalidSource": "import {it,expect} from 'vitest'; it('works',()=>expect(1).toBe(1)); it('works',()=>expect(2).toBe(2));",
      "validSource": "import {it,expect} from 'vitest'; it('one',()=>expect(1).toBe(1)); it('two',()=>expect(2).toBe(2));",
      "invalid": {
        "exit": 1,
        "diagnostics": [
          {
            "code": "vitest(no-identical-title)",
            "severity": "error",
            "message": "Test title is used multiple times in the same describe block."
          }
        ]
      },
      "valid": {
        "exit": 0,
        "diagnostics": []
      },
      "--fix": {
        "exit": 1,
        "changed": false,
        "after": null
      },
      "--fix-suggestions": {
        "exit": 1,
        "changed": false,
        "after": null
      }
    },
    {
      "rule": "vitest/no-import-node-test",
      "options": null,
      "invalidSource": "import {test} from 'node:test'; test('works',()=>{});",
      "validSource": "import {test,expect} from 'vitest'; test('works',()=>expect(1).toBe(1));",
      "invalid": {
        "exit": 1,
        "diagnostics": [
          {
            "code": "vitest(no-import-node-test)",
            "severity": "error",
            "message": "Do not import from `node:test`"
          }
        ]
      },
      "valid": {
        "exit": 0,
        "diagnostics": []
      },
      "--fix": {
        "exit": 1,
        "changed": false,
        "after": null
      },
      "--fix-suggestions": {
        "exit": 0,
        "changed": true,
        "after": "import {test} from \"vitest\"; test('works',()=>{});"
      }
    },
    {
      "rule": "vitest/prefer-hooks-in-order",
      "options": null,
      "invalidSource": "import {describe,beforeEach,beforeAll,it,expect} from 'vitest'; describe('x',()=>{beforeEach(()=>{});beforeAll(()=>{});it('x',()=>expect(1).toBe(1))});",
      "validSource": "import {describe,beforeEach,beforeAll,it,expect} from 'vitest'; describe('x',()=>{beforeAll(()=>{});beforeEach(()=>{});it('x',()=>expect(1).toBe(1))});",
      "invalid": {
        "exit": 1,
        "diagnostics": [
          {
            "code": "vitest(prefer-hooks-in-order)",
            "severity": "error",
            "message": "Test hooks are not in a consistent order."
          }
