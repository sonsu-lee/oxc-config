{
  "name": "@sonsu/oxc-config",
  "version": "0.0.0",
  "private": true,
  "description": "Composable personal Oxlint and Oxfmt configurations",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "import": "./dist/oxlint/index.js",
      "default": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "import": "./dist/oxfmt/index.js",
      "default": "./dist/oxfmt/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0"
}
