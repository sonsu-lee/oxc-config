{
  "name": "@sonsu-lee/oxc-config",
  "version": "0.1.1",
  "description": "Composable personal Oxlint and Oxfmt configurations",
  "homepage": "https://sonsu.dev",
  "bugs": {
    "url": "https://github.com/sonsu-lee/oxc-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "sonsu-lee",
    "url": "https://sonsu.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sonsu-lee/oxc-config.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "import": "./dist/oxlint/index.js",
      "default": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "import": "./dist/oxfmt/index.js",
      "default": "./dist/oxfmt/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepack": "node scripts/build.mjs",
    "rules:update": "pnpm run build && node scripts/effective-rules.mjs --write",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "verify": "pnpm test && pnpm run lint && pnpm run format:check && pnpm run verify:consumer",
    "verify:consumer": "node scripts/verify-consumer.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0"
}
