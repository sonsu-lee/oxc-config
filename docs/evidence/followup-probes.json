      },
      "valid": {
        "exit": 0,
        "diagnostics": []
      },
      "--fix": {
        "exit": 1,
        "changed": false,
        "after": null
      },
      "--fix-suggestions": {
        "exit": 1,
        "changed": false,
        "after": null
      }
    },
